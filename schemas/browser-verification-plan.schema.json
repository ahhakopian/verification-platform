{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "sourceReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "path",
          "reference"
        ]
      },
      "minItems": 1
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "topology": {
            "const": "wsl-windows"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "topology",
          "description"
        ]
      },
      "minItems": 1
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "description",
          "dependsOn"
        ]
      },
      "minItems": 0
    },
    "configurationReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "planned",
              "realized"
            ]
          },
          "purpose": {
            "enum": [
              "fixture",
              "provider-declaration",
              "setup"
            ]
          }
        },
        "required": [
          "id",
          "path",
          "disposition",
          "purpose"
        ]
      },
      "minItems": 0
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "proof": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "mandatory": {
                  "type": "boolean"
                },
                "acceptedSources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "source": {
                        "type": "string",
                        "minLength": 1
                      },
                      "providerId": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "source",
                      "providerId"
                    ]
                  },
                  "minItems": 1
                },
                "capabilityId": {
                  "type": "string",
                  "minLength": 1
                },
                "capabilityVersion": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "source",
                "description",
                "mandatory",
                "acceptedSources"
              ]
            },
            "minItems": 1
          },
          "environmentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "prerequisiteIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "mode": {
            "enum": [
              "automated",
              "assisted",
              "human"
            ]
          },
          "allowedEffects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "timing": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "deadlineMs": {
                "type": "integer",
                "minimum": 1
              },
              "observationWindowMs": {
                "type": "integer",
                "minimum": 1
              },
              "completionBoundary": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "deadlineMs"
            ]
          },
          "support": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "disposition": {
                "enum": [
                  "generic",
                  "project-planned",
                  "project-existing",
                  "unavailable"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "configurationRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "disposition",
              "reason",
              "configurationRefs"
            ]
          }
        },
        "required": [
          "id",
          "sourceRefs",
          "expected",
          "proof",
          "environmentIds",
          "prerequisiteIds",
          "mode",
          "allowedEffects",
          "timing",
          "support"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "planId",
    "sourceReferences",
    "environments",
    "prerequisites",
    "configurationReferences",
    "claims"
  ]
}
