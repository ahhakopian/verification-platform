{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executionId": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "planDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bindingDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "assignmentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "generatedSourceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fixtureDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "providerSources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "entry": {
                "type": "string",
                "minLength": 1
              },
              "entryDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "declarations": {
                "type": "string",
                "minLength": 1
              },
              "declarationsDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "version",
              "entry",
              "entryDigest",
              "declarations",
              "declarationsDigest"
            ]
          },
          "minItems": 0
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "version"
            ]
          },
          "minItems": 0
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runtime": {
              "type": "string",
              "minLength": 1
            },
            "build": {
              "type": "string",
              "minLength": 1
            },
            "tools": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "runtime",
            "build",
            "tools"
          ]
        }
      },
      "required": [
        "executionId",
        "attempt",
        "planDigest",
        "bindingDigest",
        "assignmentDigest",
        "generatedSourceDigest",
        "fixtureDigest",
        "providerSources",
        "providers",
        "provenance"
      ]
    },
    "environmentId": {
      "type": "string",
      "minLength": 1
    },
    "workerIndex": {
      "type": "integer",
      "minimum": 0
    },
    "testKey": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "stage": {
      "enum": [
        "browser",
        "project",
        "target",
        "gate"
      ]
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "observations": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      },
      "minItems": 0
    },
    "cleanupErrors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "identity",
    "environmentId",
    "workerIndex",
    "sequence",
    "stage",
    "status",
    "reason",
    "observations",
    "evidence",
    "cleanupErrors"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "browser"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "PASS",
              "RECOVERED",
              "BLOCKED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "project"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "PASS",
              "BLOCKED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "target"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "PASS",
              "CREATED",
              "BLOCKED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "gate"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "ENVIRONMENT READY",
              "PREFLIGHT_BLOCKED"
            ]
          }
        }
      }
    }
  ]
}
