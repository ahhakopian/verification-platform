{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executionId": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "planDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bindingDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "assignmentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "generatedSourceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fixtureDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "providerSources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "entry": {
                "type": "string",
                "minLength": 1
              },
              "entryDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "declarations": {
                "type": "string",
                "minLength": 1
              },
              "declarationsDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "version",
              "entry",
              "entryDigest",
              "declarations",
              "declarationsDigest"
            ]
          },
          "minItems": 0
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "version"
            ]
          },
          "minItems": 0
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runtime": {
              "type": "string",
              "minLength": 1
            },
            "build": {
              "type": "string",
              "minLength": 1
            },
            "tools": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "runtime",
            "build",
            "tools"
          ]
        }
      },
      "required": [
        "executionId",
        "attempt",
        "planDigest",
        "bindingDigest",
        "assignmentDigest",
        "generatedSourceDigest",
        "fixtureDigest",
        "providerSources",
        "providers",
        "provenance"
      ]
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "INCONCLUSIVE"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claimId": {
            "type": "string",
            "minLength": 1
          },
          "environmentId": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "INCONCLUSIVE"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "claimId",
          "environmentId",
          "verdict",
          "reason",
          "evidenceIds"
        ]
      },
      "minItems": 1
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "PASS": {
          "type": "integer",
          "minimum": 0
        },
        "FAIL": {
          "type": "integer",
          "minimum": 0
        },
        "BLOCKED": {
          "type": "integer",
          "minimum": 0
        },
        "INCONCLUSIVE": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "INCONCLUSIVE"
      ]
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "exitCode",
        "status"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "identity",
    "verdict",
    "claims",
    "counts",
    "runner",
    "limitations"
  ]
}
