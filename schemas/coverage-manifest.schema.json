{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executionId": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "planDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bindingDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "assignmentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "generatedSourceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fixtureDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "providerSources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "entry": {
                "type": "string",
                "minLength": 1
              },
              "entryDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "declarations": {
                "type": "string",
                "minLength": 1
              },
              "declarationsDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "version",
              "entry",
              "entryDigest",
              "declarations",
              "declarationsDigest"
            ]
          },
          "minItems": 0
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "version"
            ]
          },
          "minItems": 0
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runtime": {
              "type": "string",
              "minLength": 1
            },
            "build": {
              "type": "string",
              "minLength": 1
            },
            "tools": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "runtime",
            "build",
            "tools"
          ]
        }
      },
      "required": [
        "executionId",
        "attempt",
        "planDigest",
        "bindingDigest",
        "assignmentDigest",
        "generatedSourceDigest",
        "fixtureDigest",
        "providerSources",
        "providers",
        "provenance"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claimId": {
            "type": "string",
            "minLength": 1
          },
          "environmentId": {
            "type": "string",
            "minLength": 1
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "proofIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "mode": {
            "enum": [
              "automated",
              "assisted",
              "human"
            ]
          },
          "testKey": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "capabilityIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "capabilityVersions": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "blocker": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "claimId",
          "environmentId",
          "sourceRefs",
          "proofIds",
          "mode",
          "assertions",
          "steps",
          "capabilityIds",
          "capabilityVersions"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "identity",
    "entries"
  ]
}
