{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[^/]+/[^/]+$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "asset",
        "sha256"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "integration": {
          "type": "string",
          "minLength": 1
        },
        "planSchema": {
          "type": "string",
          "minLength": 1
        },
        "descriptors": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "integration",
        "planSchema",
        "descriptors"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "repository",
    "tag",
    "sourceCommit",
    "index",
    "resources"
  ]
}
